; ============================================================================
; settings.xml for the operator's external REFERENCE datapack
;   target: the reference datapack root (LOCAL only, kept out of git)
;   place at: <generator run CWD>/settings.xml  (next to dest/map/tileset/)
;
; Tile indices below were DERIVED from that datapack's hand-authored maps after
; running tools/datapack-tileset-deduplicate on its map/ (the per-layer
; tile-role decode lives with the dataset). The gameplay-critical tiles
; (ground / water / tall grass / ledges / collisions / interior floor+walls) are
; data-derived and confident. A few non-essential biome variants (sand/snow/
; mountain ground) reuse plausible tileset-1 ground tiles and are marked
; "; guess". The interior furniture + tree overlays still use the CatchChallenger
; template/ set (which references inside-*/wood tilesets that datapack lacks) —
; replace those with matching templates or inline tiles for a fully clean run.
;
; Its .tsx live FLAT in map/ (not map/tileset/); stage them into
; <run>/dest/map/tileset/ so these bare names resolve (see DATAPACK-CONFIG.md).
; No usable transition bands -> dotransition=false.
; ============================================================================

[General]
cityRadius=3
displaycity=false
displayregion=false
displayzone=false
doallmap=true
dominimap=true
dotransition=false
dovegetation=true
levelmapmax=50
levelmapmin=2
levelmapscale=0.05
; the map LABEL written under dest/map/main/<maincode>/, spelled out so the
; generator never writes it back into this linked file (it would strip the
; comments above)
maincode=generated
mapHeight=40
mapWidth=40
mapXCount=64
mapYCount=64
maxCityLinks=3
miniMapDivisor=4.0
scale_City=3
scale_TerrainMap=0.03
scale_TerrainMoisure=0.1
scale_Zone=0.1
seed=400
tileStep=4

